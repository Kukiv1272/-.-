{
  "manifest_version": 3,
  "name": "Контур.Толк — фильтр запрещённых слов",
  "version": "1.0.0",
  "description": "Блокирует отправку сообщений с запрещёнными словами в обычном и плавающем окне.",
  "homepage_url": "https://github.com/Kukiv1272/kontur-filter",
  "permissions": ["storage", "alarms"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Фильтр запрещённых слов",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://talk.kontur.ru/*",
        "https://*.talk.kontur.ru/*",
        "https://*.ktalk.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
